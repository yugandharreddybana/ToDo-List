# =====================================================================
# Todo Productivity Suite — environment configuration
# Copy this file to `.env` at the repository root and fill in real values.
# =====================================================================

# ---------- Frontend (deployments/UI) ----------
VITE_API_BASE_URL=
VITE_APP_NAME="Productivity Suite"

# ---------- Middleware (deployments/Middleware) ----------
MIDDLEWARE_PORT=3001
MIDDLEWARE_CORS_ORIGIN=http://localhost:3002
BACKEND_URL=http://localhost:8080

# JWT — generate with: openssl rand -base64 64
JWT_ACCESS_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# NVIDIA NIM (server-side only; OpenAI-compatible)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1.5

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ---------- Backend (deployments/Backend) ----------
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=productivity
POSTGRES_USER=productivity
POSTGRES_PASSWORD=replace-with-a-strong-unique-password

# JWT (must match middleware secrets so tokens verify end-to-end)
APP_JWT_SECRET=use-the-same-value-as-JWT_ACCESS_SECRET

# CORS
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ---------- Docker Compose ----------
COMPOSE_PROJECT_NAME=productivity-suite
